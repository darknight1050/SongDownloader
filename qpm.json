{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "SongDownloader",
    "id": "songdownloader",
    "version": "0.8.7",
    "url": "https://github.com/darknight1050/SongDownloader",
    "additionalData": {
      "overrideSoName": "libsongdownloader.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./build.ps1"
      ],
      "clean": [
        "pwsh ./build.ps1 -clean"
      ],
      "qmod": [
        "pwsh ./build.ps1 -clean",
        "pwsh ./createqmod.ps1 SongDownloader"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "build",
      "extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "SongDownloader.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^8.2.1",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4500.*",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.5.8",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.20.1",
      "additionalData": {}
    },
    {
      "id": "libcurl",
      "versionRange": "^7.78.0",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "playlistcore",
      "versionRange": "^1.7.0",
      "additionalData": {}
    },
    {
      "id": "rapidjson-macros",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "reflectcpp",
      "versionRange": "^0.25.0",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "songcore",
      "versionRange": "^1.3.2",
      "additionalData": {}
    }
  ]
}
